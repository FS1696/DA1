# -----------------------------------------------------------------------------
# BANK STOCK ANALYSIS - ENVIRONMENT TEMPLATE
# Copy this file to .env and replace placeholder values with your real values.
# Never commit the real .env file or API credentials to GitHub.
# -----------------------------------------------------------------------------

# Database (TimescaleDB / PostgreSQL)
POSTGRES_DB=stockdb
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://stockuser:change_me@db:5432/stockdb

# Market data provider
# Provisional project choice: FHSC. Change only if the group selects another
# supported vnstock v6.0.1 source (dnse, ssi or tcbs) and configures its keys.
DATA_SOURCE=fhsc
FHSC_API_KEY=put_your_fhsc_api_key_here

# Stocks tracked by this project (the 12 tickers in the specification)
TICKERS=ACB,BID,CTG,HDB,MBB,SHB,STB,TCB,TPB,VCB,VIB,VPB

# Application and scheduler
TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO
SCHEDULE_DAY_OF_WEEK=mon-fri
SCHEDULE_HOUR=16
SCHEDULE_MINUTE=0

# Data collection
BACKFILL_YEARS=5
RECONCILE_BUFFER_DAYS=7
FETCH_DELAY_SECONDS=1.0
FETCH_MAX_RETRIES=3

# Telegram notifications
TELEGRAM_BOT_TOKEN=put_token_here
TELEGRAM_CHAT_ID=put_chat_id_here
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_MAX_RETRIES=3
SEND_DAILY_SUMMARY=true
